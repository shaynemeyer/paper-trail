# Database (podman-compose up -d brings up pgvector/pgvector:pg16)
DATABASE_URL=postgresql+asyncpg://paper_trail:paper_trail@localhost:5443/paper_trail

# JWT Configuration
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Logging
LOG_LEVEL=DEBUG        # DEBUG, INFO, WARNING, ERROR
JSON_LOGS=false        # false for development, true for production

# Embeddings - Ollama runs on the host (not in podman-compose)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIM=2560

# CORS - only needed when the frontend runs on a different origin (e.g. the Vite
# dev server); in the combined Docker image the frontend is served same-origin.
CORS_ORIGINS=http://localhost:5173
